# Application
APP_ENV=production
APP_PORT=8080
APP_HOST=0.0.0.0

# Database
DB_USER=wedding
DB_PASSWORD=changeme
DB_NAME=wedding
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable

# JWT
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Server Port (Go backend)
PORT=8080
